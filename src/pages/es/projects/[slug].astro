---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ProjectCaseStudy from '../../../components/ui/ProjectCaseStudy.astro'
import { getCollection, render } from 'astro:content'
import { getAvailableLocalesForSlug, getProjectSlug } from '../../../lib/projects'

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.lang === 'es')
  return projects.map((project) => ({
    params: { slug: getProjectSlug(project) },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await render(project)
const alternateLocales = await getAvailableLocalesForSlug(getProjectSlug(project))
---

<BaseLayout title={project.data.title} description={project.data.description} alternateLocales={alternateLocales}>
  <ProjectCaseStudy project={project}>
    <Content />
  </ProjectCaseStudy>
</BaseLayout>
