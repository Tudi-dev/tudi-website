---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getLocale, getDictionary } from '../../lib/i18n'
import { getProjectsByLocale, getProjectSlug } from '../../lib/projects'

const locale = getLocale(Astro.currentLocale)
const t = getDictionary(locale)
const projects = await getProjectsByLocale(locale, true)
---

<BaseLayout title={t.home.title} description={t.home.description}>
  <section>
    <h1>tudi</h1>
    <p>{t.home.intro}</p>
  </section>

  <section>
    <h2>{t.home.featuredHeading}</h2>
    <ul>
      {
        projects.map((project) => (
          <li>
            <a href={getRelativeLocaleUrl(locale, `/projects/${getProjectSlug(project)}`)}>{project.data.title}</a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
