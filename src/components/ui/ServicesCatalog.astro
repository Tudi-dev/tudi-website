---
import { getLocale } from '../../lib/i18n'
import { getServicesCatalog } from '../../lib/servicesCatalog'
import { getColorForLabel } from '../../lib/colorSystem'

const locale = getLocale(Astro.currentLocale)
const catalog = getServicesCatalog(locale)
---

<section class="border-b-2 border-[var(--text-h)]">
  <div class="border-b-2 border-[var(--text-h)]">
    <div class="mx-auto grid max-w-[1440px] gap-8 px-6 py-16 lg:grid-cols-[1fr_auto] lg:items-end lg:px-12">
      <div>
        <p class="text-xs font-semibold tracking-[0.18em] text-[var(--accent)] uppercase">{catalog.eyebrow}</p>
        <h2 class="services-heading mt-6 max-w-[24ch]">{catalog.heading}</h2>
      </div>
      <p class="max-w-[34ch] text-sm leading-relaxed font-semibold text-[var(--accent)]">&ldquo;{catalog.intro}&rdquo;</p>
    </div>
  </div>

  <fieldset class="tabs-group border-0 p-0 m-0">
    <legend class="sr-only">{catalog.eyebrow}</legend>

    {
      catalog.disciplines.map((discipline, index) => (
        <input
          type="radio"
          name="discipline"
          id={`tab-${discipline.key}`}
          class="tab-input"
          checked={index === 0}
        />
      ))
    }

    <div class="bg-[var(--bg)]">
      <div class="mx-auto grid max-w-[1440px] gap-px md:grid-cols-3">
        {
          catalog.disciplines.map((discipline) => (
            <label for={`tab-${discipline.key}`} class="tab-label flex flex-col gap-2 bg-[var(--bg)] px-7 py-4">
              <span class="flex items-center gap-2.5 text-[11px] font-semibold tracking-[0.16em] uppercase opacity-75">
                <span class="block h-1.5 w-5.5" style={{ background: discipline.accent }} />
                {discipline.items.length} {catalog.countSuffix}
              </span>
              <span class="tab-label-name">{discipline.name}</span>
              <span class="text-[13px] opacity-80">{discipline.lead}</span>
            </label>
          ))
        }
      </div>
    </div>

    <div class="shared-meta bg-[var(--accent)] text-white">
      <div class="mx-auto grid max-w-[1440px] grid-cols-2 gap-x-8 gap-y-1 px-6 py-2 sm:grid-cols-3 lg:px-12">
        <div>
          <span class="meta-label">{catalog.metaLabels.levels}</span>
          <span class="meta-value">{catalog.sharedMeta.levels}</span>
        </div>
        <div>
          <span class="meta-label">{catalog.metaLabels.location}</span>
          <span class="meta-value">{catalog.sharedMeta.location}</span>
        </div>
        <div>
          <span class="meta-label">{catalog.metaLabels.languages}</span>
          <span class="meta-value">{catalog.sharedMeta.languages}</span>
        </div>
      </div>
    </div>

    <div class="panels mx-auto max-w-[1440px] px-6 lg:px-12">
      {
        catalog.disciplines.map((discipline) => (
          <div class="panel" data-panel={discipline.key}>
            {discipline.items.map((item) => (
              <article class="service-item grid gap-8 border-b border-[var(--border)] py-9 lg:grid-cols-[56px_1.25fr_1fr]">
                <span class="service-num font-[family-name:var(--mono)] text-[13px] text-[var(--text-h)]">
                  {item.num}
                </span>
                <div>
                  <h3 class="service-title">{item.title}</h3>
                  <p class="mt-3 max-w-[56ch] text-[15px] leading-relaxed text-[var(--text)]">{item.text}</p>
                  {item.note && (
                    <p
                      class="service-note mt-4 max-w-[56ch] pl-3.5 text-[13px] leading-relaxed text-[var(--text)] opacity-80"
                      style={{ borderLeft: `2px solid ${discipline.accent}` }}
                    >
                      {item.note}
                    </p>
                  )}
                </div>
                <div class="flex flex-col gap-4">
                  <div class="grid grid-cols-[92px_1fr] gap-4">
                    <span class="meta-label">{catalog.fieldLabels.profile}</span>
                    <span class="text-sm font-semibold text-[var(--text-h)]">{item.profile}</span>
                  </div>
                  <div class="grid grid-cols-[92px_1fr] gap-4">
                    <span class="meta-label">{catalog.fieldLabels.stack}</span>
                    <div class="flex flex-wrap gap-1.5">
                      {item.stack.map((tool) => {
                        const combo = getColorForLabel(tool)
                        return (
                          <span
                            class="px-2.5 py-1 text-xs font-semibold whitespace-nowrap"
                            style={{ background: combo.background, color: combo.principal }}
                          >
                            {tool}
                          </span>
                        )
                      })}
                    </div>
                  </div>
                  <div class="grid grid-cols-[92px_1fr] gap-4">
                    <span class="meta-label">{catalog.fieldLabels.idealFor}</span>
                    <span class="text-sm leading-relaxed text-[var(--text)] opacity-80">{item.idealFor}</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        ))
      }
    </div>
  </fieldset>

  <div class="mx-auto flex max-w-[1440px] flex-wrap items-center gap-7 px-6 py-14 lg:px-12">
    <a
      href="mailto:contacto@tudi.mx"
      class="block bg-[var(--accent)] px-7 py-4.5 text-[13px] font-bold tracking-[0.14em] text-white uppercase hover:opacity-90"
    >
      {catalog.ctaLabel}
    </a>
    <span class="text-[13px] text-[var(--text)] opacity-70">{catalog.ctaNote}</span>
  </div>
</section>

<style>
  .services-heading {
    margin: 0;
    font-family: var(--display);
    font-size: 2.4rem;
    font-weight: 400;
    line-height: 1.05;
    color: var(--text-h);
    text-wrap: pretty;
  }

  .tab-input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .tab-label {
    cursor: pointer;
    color: var(--text-h);
  }

  .tab-label-name {
    font-family: var(--display);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.05;
  }

  #tab-design:focus-visible ~ div label[for='tab-design'],
  #tab-development:focus-visible ~ div label[for='tab-development'],
  #tab-devops:focus-visible ~ div label[for='tab-devops'] {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  #tab-design:checked ~ div label[for='tab-design'],
  #tab-development:checked ~ div label[for='tab-development'],
  #tab-devops:checked ~ div label[for='tab-devops'] {
    background: var(--text-h);
    color: var(--bg);
  }

  .panel {
    display: none;
  }

  #tab-design:checked ~ .panels [data-panel='design'],
  #tab-development:checked ~ .panels [data-panel='development'],
  #tab-devops:checked ~ .panels [data-panel='devops'] {
    display: block;
  }

  .service-title {
    margin: 0;
    font-family: var(--display);
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--text-h);
    text-wrap: pretty;
  }

  .service-num {
    display: block;
    padding-top: 0.5rem;
  }

  .meta-label {
    display: block;
    margin-bottom: 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .shared-meta .meta-label {
    color: rgb(0 0 0 / 55%);
    opacity: 1;
  }

  .meta-value {
    display: block;
    font-size: 14px;
  }
</style>
