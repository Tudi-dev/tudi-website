---
import { Image } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { CollectionEntry } from 'astro:content'
import { getDictionary, getLocale } from '../../lib/i18n'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const locale = getLocale(Astro.currentLocale)
const t = getDictionary(locale)
const { title, description, client, caseLabel, concept, designer, tags, logo, logoBackground, gallery, challengeHeading } =
  project.data
const projectsHref = getRelativeLocaleUrl(locale, '/projects')
const contactHref = getRelativeLocaleUrl(locale, '/contact')
const caseColor = logoBackground ?? 'var(--text-h)'
---

<div style={{ '--case-color': caseColor }}>
<article class="border-b-2 border-[var(--case-color)]">
  <div class="mx-auto max-w-[1440px] px-6 pt-8 lg:px-12">
    <a href={projectsHref} class="text-xs font-semibold tracking-[0.14em] text-[var(--text)] uppercase opacity-70 hover:opacity-100">
      {t.projectDetail.backLink}
    </a>
  </div>

  <div class="mx-auto grid max-w-[1440px] gap-12 px-6 py-11 lg:grid-cols-[1.2fr_1fr] lg:items-end lg:px-12">
    <div class="flex flex-col gap-6">
      {caseLabel && <p class="text-xs font-semibold tracking-[0.18em] text-[var(--accent)] uppercase">{caseLabel}</p>}
      <h1 class="case-title max-w-[18ch]">{title}</h1>
      <p class="max-w-[44ch] text-lg leading-relaxed text-[var(--text)]">{description}</p>
    </div>
    <div class="flex flex-col">
      {
        client && (
          <div class="flex flex-col gap-1.5 border-t border-[var(--border)] py-4">
            <span class="case-meta-label">{t.projectDetail.metaLabels.client}</span>
            <span class="text-[var(--text-h)]">{client}</span>
          </div>
        )
      }
      {
        concept && (
          <div class="flex flex-col gap-1.5 border-t border-[var(--border)] py-4">
            <span class="case-meta-label">{t.projectDetail.metaLabels.concept}</span>
            <span class="text-[var(--text-h)]">{concept}</span>
          </div>
        )
      }
      {
        designer && (
          <div class="flex flex-col gap-1.5 border-t border-[var(--border)] py-4">
            <span class="case-meta-label">{t.projectDetail.metaLabels.designer}</span>
            <span class="text-[var(--text-h)]">{designer}</span>
          </div>
        )
      }
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 border-t border-[var(--border)] pt-4">
            {tags.map((tag) => (
              <span class="bg-[var(--text-h)] px-2.5 py-1 text-xs font-semibold text-[var(--bg)]">{tag}</span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</article>

{
  logo && (
    <div
      class="flex items-center justify-center border-b-2 border-[var(--case-color)] px-6 py-20"
      style={{ background: logoBackground }}
    >
      <Image src={logo} alt={title} class="h-auto w-full max-w-[520px] object-contain" widths={[400, 800, 1040]} sizes="520px" />
    </div>
  )
}

{
  challengeHeading && (
    <section class="border-b-2 border-[var(--case-color)]">
      <div class="mx-auto grid max-w-[1440px] lg:grid-cols-[1fr_1.15fr]">
        <div class="border-b-2 border-[var(--case-color)] px-6 py-14 lg:border-r-2 lg:border-b-0 lg:px-12">
          <h2 class="challenge-heading max-w-[20ch]">{challengeHeading}</h2>
        </div>
        <div class="case-content flex flex-col gap-5 px-6 py-14 lg:px-12">
          <slot />
        </div>
      </div>
    </section>
  )
}

{
  gallery.length > 0 && (
    <section class="border-b-2 border-[var(--case-color)]">
      <div class="mx-auto max-w-[1440px] px-6 pt-12 pb-6 lg:px-12">
        <span class="text-xs font-semibold tracking-[0.18em] text-[var(--text)] uppercase opacity-70">
          {t.projectDetail.applicationsLabel}
        </span>
      </div>
      <div class="border-t-2 border-[var(--case-color)] bg-[var(--bg)]">
        <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-px sm:grid-cols-2">
          {gallery.map((item) => (
            <figure class="m-0 flex flex-col bg-[var(--bg)]">
              <Image
                src={item.image}
                alt={item.caption}
                class="aspect-[4/3] w-full object-cover"
                widths={[400, 800]}
                sizes="(min-width: 640px) 50vw, 100vw"
              />
              <figcaption class="px-3.5 py-3 text-xs leading-relaxed text-[var(--text)] opacity-80">
                {item.caption}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

<section class="border-b-2 border-[var(--case-color)]">
  <div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-7 px-6 py-14 lg:px-12">
    <p class="case-closing max-w-[28ch]">{t.projectDetail.closingQuestion}</p>
    <div class="flex flex-wrap items-center gap-6">
      <a
        href={contactHref}
        class="block bg-[var(--accent)] px-7 py-4.5 text-[13px] font-bold tracking-[0.14em] text-white uppercase hover:opacity-90"
      >
        {t.projectDetail.ctaLabel}
      </a>
      <a
        href={projectsHref}
        class="border-b-2 border-[var(--accent)] pb-1 text-[13px] font-bold tracking-[0.14em] text-[var(--text-h)] uppercase"
      >
        {t.projectDetail.ctaSecondary}
      </a>
    </div>
  </div>
</section>
</div>

<style>
  .case-title {
    margin: 0;
    font-family: var(--display);
    font-size: 2.75rem;
    font-weight: 400;
    line-height: 0.98;
    color: var(--text-h);
    text-wrap: pretty;
  }

  @media (width >= 1024px) {
    .case-title {
      font-size: 4rem;
    }
  }

  .case-meta-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .challenge-heading {
    margin: 0;
    font-family: var(--display);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.05;
    color: var(--text-h);
    text-wrap: pretty;
  }

  .case-closing {
    margin: 0;
    font-family: var(--display);
    font-size: 1.6rem;
    line-height: 1.3;
    color: var(--text-h);
    text-wrap: pretty;
  }
</style>

<style is:global>
  .case-content p {
    margin: 0;
    max-width: 56ch;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text);
  }
</style>
