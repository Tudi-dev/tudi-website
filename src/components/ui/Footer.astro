---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { navLinks } from '../../lib/nav'
import { getLocale, getRelativePath, otherLocale, getDictionary } from '../../lib/i18n'
import SocialLinks from './SocialLinks.astro'

const locale = getLocale(Astro.currentLocale)
const t = getDictionary(locale)
const homeHref = getRelativeLocaleUrl(locale, '/')

const switchLocale = otherLocale(locale)
const switchHref = getRelativeLocaleUrl(switchLocale, getRelativePath(Astro.url.pathname, locale))
---

<footer class="tudi-footer border-t-2 border-[var(--footer-fg)] bg-[var(--footer-bg)] text-[var(--footer-fg)]">
  <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-10 px-6 py-12 md:grid-cols-[1fr_auto] md:gap-x-16 md:gap-y-10 md:px-12">
    <a href={homeHref} class="block leading-none" aria-label={t.header.logoAria}>
      <svg
        viewBox="0 0 100 48"
        width="112"
        height="54"
        role="img"
        aria-label={t.header.logoMarkAria}
        class="tudi-logo block overflow-visible"
      >
        <polygon
          class="tudi-logo-mark"
          points="45.98,18.55 45.95,41.31 43.09,41.31 37.88,38.2 37.84,18.55 29.01,18.55 29.04,39.53 40.18,45.96 54.98,45.96 54.98,18.55"
        ></polygon>
        <path
          class="tudi-logo-accent"
          d="M77.51,4.92l0.02,13.42l-5.5,0l-12.17,7.07v13.45l12.17,7.02l13.93,0.01V4.92H77.51z M74.73,40.9l-6.38-3.76V27.07l6.38-3.76l2.71,0V40.9L74.73,40.9z"
        ></path>
        <polygon class="tudi-logo-mark" points="99.33,14.71 99.34,9.65 95.14,7.22 90.86,7.22 90.86,14.71"></polygon>
        <rect class="tudi-logo-mark" x="90.72" y="17.9" width="8.53" height="28.1"></rect>
        <polygon
          class="tudi-logo-mark"
          points="18.39,38.54 18.39,9.16 27.22,9.16 27.22,1.96 1.17,1.96 1.17,9.16 9.86,9.16 9.86,40.07 21.28,45.87 31.01,45.87"
        ></polygon>
      </svg>
    </a>
    <div class="flex flex-col items-start gap-6 md:items-end">
      <div class="flex gap-5">
        <SocialLinks
          labels={{
            facebook: t.footer.facebookAria,
            linkedin: t.footer.linkedinAria,
            youtube: t.footer.youtubeAria,
            instagram: t.footer.instagramAria,
          }}
        />
      </div>
      <div class="flex flex-col items-start gap-2 md:items-end">
        <a href="mailto:contacto@tudi.mx" class="text-sm hover:text-[var(--accent)]"> contacto@tudi.mx </a>
        <span class="text-sm text-[var(--footer-fg)]/70">{t.footer.location}</span>
      </div>
    </div>
    <div
      class="col-span-full mt-2 flex flex-col gap-6 border-t border-[var(--footer-fg)]/20 pt-6 md:flex-row md:items-baseline md:justify-between"
    >
      <nav aria-label={t.footer.footerNavAria} class="flex flex-wrap gap-8">
        {
          navLinks.map((link) => (
            <a
              href={getRelativeLocaleUrl(locale, link.path)}
              class="text-sm text-[var(--footer-fg)]/85 hover:text-[var(--accent)]"
            >
              {t.nav[link.key]}
            </a>
          ))
        }
        <a
          href={switchHref}
          aria-label={t.languageSwitcher.label}
          class="text-sm text-[var(--footer-fg)]/85 hover:text-[var(--accent)]"
        >
          {t.languageSwitcher.code}
        </a>
      </nav>
      <span class="text-lg font-medium"
        >{t.footer.tagline.before} <span class="text-[var(--accent)]">&amp;</span> {t.footer.tagline.after}</span
      >
    </div>
  </div>
  <div class="h-3.5 bg-[var(--accent)]"></div>
</footer>

<style>
  .tudi-footer {
    --footer-bg: var(--text-h);
    --footer-fg: var(--bg);
  }

  @media (prefers-color-scheme: dark) {
    .tudi-footer {
      --footer-bg: var(--bg);
      --footer-fg: var(--text-h);
    }
  }

  .tudi-logo-mark {
    fill: var(--footer-fg);
  }

  .tudi-logo-accent {
    fill: var(--accent);
  }
</style>
