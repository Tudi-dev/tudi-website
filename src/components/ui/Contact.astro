---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getLocale, getDictionary } from '../../lib/i18n'
import { getContactContent } from '../../lib/contact'
import ContactForm from '../react/ContactForm'
import SocialLinks from './SocialLinks.astro'

const locale = getLocale(Astro.currentLocale)
const t = getDictionary(locale)
const contact = getContactContent(locale)
const portfolioHref = getRelativeLocaleUrl(locale, '/projects')
---

<section class="border-b-2 border-[var(--text-h)]">
  <div class="mx-auto grid max-w-[1440px] grid-cols-1 border-b-2 border-[var(--text-h)] lg:grid-cols-[1.15fr_1fr]">
    <div class="flex flex-col gap-5 border-b-2 border-[var(--text-h)] px-6 py-10 lg:border-r-2 lg:border-b-0 lg:px-12 lg:py-12">
      <p class="text-xs font-semibold tracking-[0.18em] text-[var(--accent)] uppercase">{contact.hero.eyebrow}</p>
      <h1 class="contact-heading max-w-[16ch]">
        {contact.hero.headingBefore} <em class="not-italic text-[var(--accent)]">{contact.hero.headingEmphasis}</em>
      </h1>
      <p class="max-w-[46ch] text-lg leading-relaxed text-pretty text-[var(--text)]">{contact.hero.intro}</p>
    </div>
    <div class="flex flex-col gap-5 bg-[#003b45] px-6 py-10 text-white lg:px-12 lg:py-12">
      <span class="text-[11px] font-semibold tracking-[0.18em] text-[#f79068] uppercase">{contact.next.eyebrow}</span>
      <div class="flex flex-col">
        {
          contact.next.steps.map((step) => (
            <div class="grid grid-cols-[44px_1fr] gap-5 border-t border-white/25 py-3.5">
              <span class="pt-1 font-[family-name:var(--mono)] text-xs text-[#f79068]">{step.num}</span>
              <div>
                <h3 class="contact-next-title">{step.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-white/70">{step.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="mx-auto grid max-w-[1440px] grid-cols-1 lg:grid-cols-[1.4fr_1fr]">
    <div class="border-b-2 border-[var(--text-h)] px-6 py-16 lg:border-r-2 lg:border-b-0 lg:px-12 lg:py-20">
      <ContactForm
        client:visible
        options={contact.form.options}
        defaultOptionIndex={contact.form.defaultOptionIndex}
        fields={contact.form.fields}
        success={contact.success}
        portfolioHref={portfolioHref}
      />
    </div>

    <div class="flex flex-col gap-9 px-6 py-16 lg:px-12 lg:py-20">
      <div class="flex flex-col gap-2.5">
        <span class="contact-sidebar-label">{contact.sidebar.emailLabel}</span>
        <a href="mailto:contacto@tudi.mx" class="contact-sidebar-email">contacto@tudi.mx</a>
      </div>
      <div class="flex flex-col gap-2.5 border-t-2 border-[var(--text-h)] pt-7">
        <span class="contact-sidebar-label">{contact.sidebar.phoneLabel}</span>
        <span class="font-[family-name:var(--mono)] text-[13px] text-[var(--text)] opacity-70">
          {contact.sidebar.phonePending}
        </span>
      </div>
      <div class="flex flex-col gap-2.5 border-t-2 border-[var(--text-h)] pt-7">
        <span class="contact-sidebar-label">{contact.sidebar.studioLabel}</span>
        <span class="text-[17px] leading-relaxed text-[var(--text-h)]">
          {contact.sidebar.studioAddressLine1}<br />
          {contact.sidebar.studioAddressLine2}
        </span>
        <span class="font-[family-name:var(--mono)] text-[13px] text-[var(--text)] opacity-70">
          {contact.sidebar.addressPending}
        </span>
      </div>
      <div class="flex flex-col gap-2.5 border-t-2 border-[var(--text-h)] pt-7">
        <span class="contact-sidebar-label">{contact.sidebar.scheduleLabel}</span>
        <span class="text-[17px] leading-relaxed text-[var(--text-h)]">{contact.sidebar.scheduleValue}</span>
        <span class="text-sm leading-relaxed text-[var(--text)] opacity-70">{contact.sidebar.scheduleNote}</span>
      </div>
      <div class="flex flex-col gap-4 border-t-2 border-[var(--text-h)] pt-7">
        <span class="contact-sidebar-label">{contact.sidebar.socialLabel}</span>
        <div class="flex gap-5">
          <SocialLinks
            labels={{
              facebook: t.footer.facebookAria,
              linkedin: t.footer.linkedinAria,
              youtube: t.footer.youtubeAria,
              instagram: t.footer.instagramAria,
            }}
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-heading {
    margin: 0;
    font-family: var(--display);
    font-size: 2.8rem;
    font-weight: 400;
    line-height: 1.05;
    color: var(--text-h);
    text-wrap: pretty;
  }

  .contact-next-title {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: #fff;
  }

  .contact-sidebar-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text);
    opacity: 0.7;
  }

  .contact-sidebar-email {
    font-family: var(--display);
    font-size: 2rem;
    line-height: 1.1;
    color: var(--text-h);
  }

  .contact-sidebar-email:hover {
    color: var(--accent);
  }
</style>
