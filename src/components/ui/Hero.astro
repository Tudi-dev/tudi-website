---
import { Image } from 'astro:assets'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getDictionary, getLocale } from '../../lib/i18n'
import heroPicture from '../../assets/heroPicture.jpg'

const locale = getLocale(Astro.currentLocale)
const t = getDictionary(locale)
const contactHref = getRelativeLocaleUrl(locale, '/contact')
const hero = t.home.hero
---

<section class="border-b-2 border-[var(--text-h)]">
  <div class="border-b-2 border-[var(--text-h)]">
  <div class="mx-auto grid max-w-[1440px] grid-cols-1 lg:grid-cols-[1.15fr_1fr]">
    <div
      class="flex flex-col gap-8 border-b-2 border-[var(--text-h)] px-6 py-14 lg:border-r-2 lg:border-b-0 lg:px-12 lg:py-24"
    >
      <p class="text-xs font-semibold tracking-[0.18em] text-[var(--text)] uppercase opacity-70">{hero.eyebrow}</p>
      <h1 class="tudi-hero-heading max-w-[16ch]">
        {hero.headingBefore}<em class="text-[var(--accent)]">{hero.headingEmphasis}</em>
      </h1>
      <p class="max-w-[48ch] text-lg leading-relaxed text-[var(--text)]">{hero.paragraph}</p>
      <div class="flex flex-wrap items-center gap-7">
        <a
          href={contactHref}
          class="block bg-[var(--accent)] px-7 py-4.5 text-[13px] font-bold tracking-[0.14em] text-white uppercase hover:opacity-90"
        >
          {hero.ctaLabel}
        </a>
        <span class="text-[13px] text-[var(--text)] opacity-70">{hero.ctaNote}</span>
      </div>
    </div>
    <div class="grid grid-rows-[1.6fr_1fr]">
      <div class="tudi-hero-photo min-h-[220px] overflow-hidden border-b-2 border-[var(--text-h)]">
        <Image src={heroPicture} alt={hero.imageAlt} class="h-full w-full object-cover" widths={[480, 800, 1200, 1600]} />
      </div>
      <div class="flex flex-col justify-between gap-6 bg-[#003b45] p-8">
        <span class="text-[11px] font-semibold tracking-[0.18em] text-white uppercase opacity-70">
          {hero.colorSystemLabel}
        </span>
        <svg viewBox="0 0 100 48" width="112" height="54" role="img" aria-label="Tudi" class="block overflow-visible">
          <polygon
            fill="#ffffff"
            points="45.98,18.55 45.95,41.31 43.09,41.31 37.88,38.2 37.84,18.55 29.01,18.55 29.04,39.53 40.18,45.96 54.98,45.96 54.98,18.55"
          ></polygon>
          <path
            fill="#f15d2a"
            d="M77.51,4.92l0.02,13.42l-5.5,0l-12.17,7.07v13.45l12.17,7.02l13.93,0.01V4.92H77.51z M74.73,40.9l-6.38-3.76V27.07l6.38-3.76l2.71,0V40.9L74.73,40.9z"
          ></path>
          <polygon fill="#ffffff" points="99.33,14.71 99.34,9.65 95.14,7.22 90.86,7.22 90.86,14.71"></polygon>
          <rect fill="#ffffff" x="90.72" y="17.9" width="8.53" height="28.1"></rect>
          <polygon
            fill="#ffffff"
            points="18.39,38.54 18.39,9.16 27.22,9.16 27.22,1.96 1.17,1.96 1.17,9.16 9.86,9.16 9.86,40.07 21.28,45.87 31.01,45.87"
          ></polygon>
        </svg>
      </div>
    </div>
  </div>
  </div>

  <div class="bg-[var(--bg)]">
    <div class="mx-auto grid max-w-[1440px] grid-cols-2 gap-px md:grid-cols-4">
      {
        hero.stats.map((stat) => (
          <div class="bg-[var(--bg)] px-6 py-7 lg:px-8">
            <span class="tudi-hero-stat block text-[var(--text-h)]">{stat.value}</span>
            <span class="mt-2 block text-xs font-semibold tracking-[0.14em] text-[var(--text)] uppercase opacity-70">
              {stat.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tudi-hero-heading {
    margin: 0;
    max-width: 16ch;
    font-family: var(--display);
    font-size: 2.75rem;
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--text-h);
    text-wrap: pretty;
  }

  .tudi-hero-heading em {
    font-style: italic;
  }

  @media (width >= 1024px) {
    .tudi-hero-heading {
      font-size: 4.6rem;
    }
  }

  .tudi-hero-photo {
    height: 100%;
    filter: grayscale(1);
  }

  .tudi-hero-stat {
    font-family: var(--display);
    font-size: 2.5rem;
    line-height: 1;
  }
</style>
