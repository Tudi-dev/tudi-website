---
import { navLinks } from '../../lib/nav'

const currentPath = Astro.url.pathname
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href))
---

<header
  class="sticky top-0 z-20 flex flex-wrap items-center gap-4 border-b-2 border-[var(--text-h)] bg-[var(--bg)] px-6 py-4 md:gap-6 md:px-12 md:py-4.5"
>
  <a href="/" class="block leading-none" aria-label="Tudi — inicio">
    <svg
      viewBox="0 0 100 48"
      width="60"
      height="29"
      role="img"
      aria-label="Tudi — Desarrollo & Diseño"
      class="tudi-logo block overflow-visible"
    >
      <polygon
        class="tudi-logo-mark"
        points="45.98,18.55 45.95,41.31 43.09,41.31 37.88,38.2 37.84,18.55 29.01,18.55 29.04,39.53 40.18,45.96 54.98,45.96 54.98,18.55"
      ></polygon>
      <path
        class="tudi-logo-accent"
        d="M77.51,4.92l0.02,13.42l-5.5,0l-12.17,7.07v13.45l12.17,7.02l13.93,0.01V4.92H77.51z M74.73,40.9l-6.38-3.76V27.07l6.38-3.76l2.71,0V40.9L74.73,40.9z"
      ></path>
      <polygon class="tudi-logo-mark" points="99.33,14.71 99.34,9.65 95.14,7.22 90.86,7.22 90.86,14.71"></polygon>
      <rect class="tudi-logo-mark" x="90.72" y="17.9" width="8.53" height="28.1"></rect>
      <polygon
        class="tudi-logo-mark"
        points="18.39,38.54 18.39,9.16 27.22,9.16 27.22,1.96 1.17,1.96 1.17,9.16 9.86,9.16 9.86,40.07 21.28,45.87 31.01,45.87"
      ></polygon>
    </svg>
  </a>
  <button
    type="button"
    id="nav-toggle"
    aria-controls="primary-nav"
    aria-expanded="false"
    aria-label="Abrir menú de navegación"
    class="ml-auto flex h-9 w-9 shrink-0 items-center justify-center text-[var(--text-h)] md:hidden"
  >
    <svg
      class="icon-menu"
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
    <svg
      class="icon-close"
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <line x1="5" y1="5" x2="19" y2="19"></line>
      <line x1="19" y1="5" x2="5" y2="19"></line>
    </svg>
  </button>
  <nav
    id="primary-nav"
    aria-label="Principal"
    class="w-full flex-col items-start gap-4 md:flex md:w-auto md:flex-1 md:flex-row md:items-center md:gap-6"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'border-b-2 py-1.5 text-xs font-semibold tracking-[0.14em] text-[var(--text-h)] uppercase',
            isActive(link.href) ? 'border-[var(--accent)]' : 'border-transparent hover:border-[var(--accent)]',
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <a
      href="/contact"
      class="block bg-[var(--text-h)] px-5.5 py-3.5 text-xs font-bold tracking-[0.14em] text-[var(--bg)] uppercase hover:bg-[var(--accent)] md:ml-auto"
    >
      Iniciar un proyecto
    </a>
  </nav>
</header>

<style>
  .tudi-logo-mark {
    fill: var(--text-h);
  }

  .tudi-logo-accent {
    fill: var(--accent);
  }

  #nav-toggle .icon-close {
    display: none;
  }

  #nav-toggle[aria-expanded='true'] .icon-menu {
    display: none;
  }

  #nav-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  @media (width <= 767px) {
    #primary-nav {
      display: none;
      border-top: 2px solid var(--border);
      padding-top: 1rem;
    }

    #primary-nav.is-open {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle')
  const nav = document.getElementById('primary-nav')

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('is-open')
      toggle.setAttribute('aria-expanded', String(isOpen))
    })
  }
</script>
